# Public Mapbox access token. Leave empty to use MapLibre and OpenFreeMap.
# Never commit a real token. Restrict the token by URL in the Mapbox account before launch.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Development only. Set to 1 to simulate map-storage consent while running `next dev`.
# Production builds ignore this. Visitors stay unconsented until the cookie banner sets consent.
NEXT_PUBLIC_MAP_CONSENT=

# Contact form (Cloudflare Turnstile). Public site key for the widget; secret stays on Pages only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pages Functions only (never commit real values):
# TURNSTILE_SECRET_KEY=
# MAP_LOAD_HASH_SALT=
# CONTACT_HOURLY_MAX=5
# CONTACT_GLOBAL_DAILY_MAX=200
# ACCESS_AUD=
# ACCESS_TEAM_DOMAIN=
# ADMIN_EMAILS=comma-separated@addresses
# ADMIN_DEV_BYPASS=1
# SOURCE_CHECKER_DEV_HOSTS=127.0.0.1,localhost

# Local admin UI header when ADMIN_DEV_BYPASS=1 on wrangler pages dev:
# NEXT_PUBLIC_ADMIN_DEV_EMAIL=you@example.com
